# Copy to .env in this directory. Never commit tokens or incident data.
# Generate once: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
TRIAGE_API_TOKEN=
TRIAGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
TRIAGE_OLLAMA_MODEL=gemma4:26b
TRIAGE_VISION_PROVIDER=ollama
TRIAGE_PROVIDER_TIMEOUT_SECONDS=90
# Compose: allow 90s primary + 90s fallback, upload, and shutdown overhead.
# Increase with provider deadlines; supervise native inference that never returns.
TRIAGE_STOP_GRACE_PERIOD=210s

# Provision weights explicitly with scripts/prepare_yolo.py; no runtime downloads.
TRIAGE_YOLO_ENABLED=true
TRIAGE_YOLO_WEIGHTS=models/yolo26n.pt
TRIAGE_YOLO_DEVICE=cpu
# Set to the checksum printed by prepare_yolo.py for integrity enforcement.
# TRIAGE_YOLO_SHA256=

# Single inference slot is appropriate for a laptop running a 26B vision model.
TRIAGE_MAX_CONCURRENCY=1
TRIAGE_DATABASE_PATH=data/triage.sqlite3
TRIAGE_RETENTION_HOURS=24
TRIAGE_MAX_RECORDS=10000
TRIAGE_MAX_FRAME_AGE_SECONDS=300

# Optional OpenAI-compatible endpoint. Both deployment and request must opt in.
TRIAGE_CLOUD_ENABLED=false
TRIAGE_CLOUD_FALLBACK_ENABLED=false
# TRIAGE_CLOUD_BASE_URL=https://your-provider.example/v1
# TRIAGE_CLOUD_API_KEY=
# TRIAGE_CLOUD_MODEL=your-vision-model

# Speech to text. Off by default; needs the optional dependency:
#   uv sync --locked --extra yolo --extra whisper
TRIAGE_TRANSCRIPTION_ENABLED=false
TRIAGE_WHISPER_MODEL=base
TRIAGE_WHISPER_DEVICE=cpu
TRIAGE_WHISPER_COMPUTE_TYPE=int8
TRIAGE_MAX_AUDIO_SECONDS=120
TRIAGE_MAX_CLIP_AGE_SECONDS=900

# Shared incident v2. Disabled unless explicit scoped principals and incidents exist.
# Quick local SYNTHETIC demo (no model downloads):
#   python -m scripts.live_demo init
#   python -m scripts.live_demo serve
# In another terminal: python -m scripts.live_demo replay
# Credentials are in ignored .runtime/live-demo.credentials.json (mode 0600).
# Use the officer, dispatch, or hospital credential at the dashboard login.
TRIAGE_LIVE_ENABLED=false
TRIAGE_LIVE_DATABASE_PATH=data/live.sqlite3
TRIAGE_LIVE_INCIDENT_IDS=[]
TRIAGE_LIVE_PRINCIPALS=[]
TRIAGE_LIVE_SOURCES=[]
# Arrays are JSON. Tokens must be >=32 chars, unique, and distinct from TRIAGE_API_TOKEN.
# Principal example (replace token; quote whole JSON value in .env):
# [{"principal_id":"officer-07","token":"<unique-token>","role":"officer","incident_ids":["incident-01"],"source_ids":[]}]
# source role requires explicit source_ids and can ingest/request assistance only.
# hospital requires explicit source_ids; responder Watch readings stay excluded.
# Watch enrollment example:
# [{"source_id":"watch-07","incident_id":"incident-01","kind":"watch","display_name":"Responder Watch","wearer_id":"officer-07","wearer_role":"responder"}]
# Source identity/binding is immutable once data exists; enroll a new source ID to reassign.
# GPS/camera/microphone have separate enrolled source IDs.
TRIAGE_LIVE_FRESHNESS_SECONDS=30
TRIAGE_LIVE_MAX_BACKFILL_SECONDS=86400
TRIAGE_LIVE_MAX_EVENTS_PER_INCIDENT=1000
TRIAGE_LIVE_MAX_OBSERVATIONS_PER_INCIDENT=128
TRIAGE_LIVE_MAX_ALERTS_PER_INCIDENT=256
TRIAGE_LIVE_MAX_SCENE_REPORTS_PER_INCIDENT=100
TRIAGE_LIVE_MAX_IDEMPOTENCY_RECORDS=10000
TRIAGE_LIVE_MAX_REQUEST_BYTES=65536
TRIAGE_LIVE_SSE_HEARTBEAT_SECONDS=10
TRIAGE_LIVE_MAX_SSE_CONNECTIONS=32
# Run one ASGI worker. Protect off-host service/proxy traffic with HTTPS.
# Source tokens and operator tokens are distinct credentials; never put them in client bundles.
# The bounded command ledger fails closed at capacity; archive the incident deliberately.

# Independent local detector/ASR/context workers. Remain off until provisioned.
TRIAGE_LIVE_MEDIA_ENABLED=false
TRIAGE_LIVE_MEDIA_MAX_REQUEST_BYTES=1500000
TRIAGE_LIVE_FRAME_QUEUE_SOURCES=8
TRIAGE_LIVE_AUDIO_QUEUE_SIZE=4
TRIAGE_LIVE_MEDIA_FRAME_MAX_AGE_SECONDS=3
TRIAGE_LIVE_MEDIA_AUDIO_MAX_AGE_SECONDS=15
TRIAGE_LIVE_DETECTOR_TIMEOUT_SECONDS=10
TRIAGE_LIVE_ASR_TIMEOUT_SECONDS=20
# Evidence stays only in bounded RAM and expires; service restart removes all media.
TRIAGE_LIVE_EVIDENCE_TTL_SECONDS=120
TRIAGE_LIVE_EVIDENCE_MAX_BYTES=16000000
TRIAGE_LIVE_EVIDENCE_MAX_ITEMS=32
TRIAGE_LIVE_MEDIA_DEDUPE_ENTRIES=2048
TRIAGE_LIVE_MEDIA_RESULTS_PER_INCIDENT=32
# Default empty: generic detector output is displayed, but generates no weapon alerts.
# Set exact labels only after evaluating the selected checkpoint on intended conditions.
# Standard COCO checkpoints have no firearm class. Model scores are not probabilities.
TRIAGE_LIVE_EVALUATED_WEAPON_LABELS=[]
TRIAGE_LIVE_ALERT_DEDUPE_SECONDS=5
TRIAGE_LIVE_CONTEXT_ENABLED=false
TRIAGE_LIVE_CONTEXT_INTERVAL_SECONDS=5
TRIAGE_LIVE_CONTEXT_TIMEOUT_SECONDS=20
TRIAGE_LIVE_CONTEXT_QUEUE_SIZE=2
# Live ASR requires TRIAGE_WHISPER_MODEL to be an already-provisioned local model directory.
# Live media uses bounded JSON + data_base64, preserving the same source/boot/sequence/time
# envelope for native clients; this implementation does not require multipart parsing.
# Separate bounded body readers prevent stalled media uploads from filling control capacity.
TRIAGE_LIVE_MEDIA_INGRESS_LIMIT=2
TRIAGE_LIVE_TELEMETRY_INGRESS_LIMIT=8
TRIAGE_LIVE_COMMAND_INGRESS_LIMIT=4
