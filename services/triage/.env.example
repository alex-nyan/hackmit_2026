# Copy to .env in this directory. Never commit tokens or incident data.
# Generate once: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
TRIAGE_API_TOKEN=
TRIAGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
TRIAGE_OLLAMA_MODEL=gemma4:26b
TRIAGE_VISION_PROVIDER=ollama
TRIAGE_PROVIDER_TIMEOUT_SECONDS=90
# Compose: allow 90s primary + 90s fallback, upload, and shutdown overhead.
# Increase with provider deadlines; supervise native inference that never returns.
TRIAGE_STOP_GRACE_PERIOD=210s

# Provision weights explicitly with scripts/prepare_yolo.py; no runtime downloads.
TRIAGE_YOLO_ENABLED=true
TRIAGE_YOLO_WEIGHTS=models/yolo26n.pt
TRIAGE_YOLO_DEVICE=cpu
# Set to the checksum printed by prepare_yolo.py for integrity enforcement.
# TRIAGE_YOLO_SHA256=

# Single inference slot is appropriate for a laptop running a 26B vision model.
TRIAGE_MAX_CONCURRENCY=1
TRIAGE_DATABASE_PATH=data/triage.sqlite3
TRIAGE_RETENTION_HOURS=24
TRIAGE_MAX_RECORDS=10000
TRIAGE_MAX_FRAME_AGE_SECONDS=300

# Optional OpenAI-compatible endpoint. Both deployment and request must opt in.
TRIAGE_CLOUD_ENABLED=false
TRIAGE_CLOUD_FALLBACK_ENABLED=false
# TRIAGE_CLOUD_BASE_URL=https://your-provider.example/v1
# TRIAGE_CLOUD_API_KEY=
# TRIAGE_CLOUD_MODEL=your-vision-model

# Speech to text. Off by default; needs the optional dependency:
#   uv sync --extra whisper
TRIAGE_TRANSCRIPTION_ENABLED=false
TRIAGE_WHISPER_MODEL=base
TRIAGE_WHISPER_DEVICE=cpu
TRIAGE_WHISPER_COMPUTE_TYPE=int8
TRIAGE_MAX_AUDIO_SECONDS=120
TRIAGE_MAX_CLIP_AGE_SECONDS=900
