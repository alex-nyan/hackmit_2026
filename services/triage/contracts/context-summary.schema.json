{
  "$defs": {
    "ModelProvenance": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "enum": [
            "ollama",
            "openai_compatible",
            "ultralytics",
            "faster_whisper"
          ],
          "title": "Provider",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "provider",
        "model",
        "revision"
      ],
      "title": "ModelProvenance",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Context Id",
      "type": "string"
    },
    "context_semantics": {
      "const": "unverified_visual_context_no_action_authority",
      "default": "unverified_visual_context_no_action_authority",
      "title": "Context Semantics",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "incident_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Incident Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelProvenance"
    },
    "requires_human_review": {
      "const": true,
      "default": true,
      "title": "Requires Human Review",
      "type": "boolean"
    },
    "snapshot_revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Snapshot Revision",
      "type": "integer"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "context_id",
    "incident_id",
    "source_id",
    "snapshot_revision",
    "generated_at",
    "evidence_refs",
    "summary",
    "limitations",
    "model",
    "requires_human_review",
    "context_semantics"
  ],
  "title": "ContextSummary",
  "type": "object"
}
