{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_cloud": {
      "default": false,
      "title": "Allow Cloud",
      "type": "boolean"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "image_base64": {
      "maxLength": 11200000,
      "minLength": 1,
      "title": "Image Base64",
      "type": "string"
    },
    "incident_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Incident Id"
    },
    "media_type": {
      "enum": [
        "image/jpeg",
        "image/png",
        "image/webp"
      ],
      "title": "Media Type",
      "type": "string"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "image_base64",
    "media_type",
    "source_id",
    "captured_at"
  ],
  "title": "TriageRequest",
  "type": "object"
}
