{
  "$defs": {
    "AlertEvent": {
      "additionalProperties": false,
      "properties": {
        "acknowledged_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "alert_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Alert Id",
          "type": "string"
        },
        "attention": {
          "enum": [
            "unacknowledged",
            "acknowledged"
          ],
          "title": "Attention",
          "type": "string"
        },
        "claim": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attribution"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "enum": [
            "open",
            "human_resolved"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_status": {
          "enum": [
            "human_reported",
            "machine_observed",
            "human_rejected"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "kind": {
          "enum": [
            "assistance_request",
            "possible_visible_weapon",
            "visual_review"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "priority": {
          "enum": [
            "urgent_review",
            "review"
          ],
          "title": "Priority",
          "type": "string"
        },
        "rejected_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requires_human_review": {
          "const": true,
          "default": true,
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "resolved_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Attribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Id"
        }
      },
      "required": [
        "alert_id",
        "kind",
        "claim",
        "source_id",
        "subject_id",
        "observed_at",
        "created_at",
        "evidence_refs",
        "priority",
        "evidence_status",
        "attention",
        "disposition",
        "freshness",
        "requires_human_review",
        "created_by",
        "acknowledged_by",
        "rejected_by",
        "resolved_by"
      ],
      "title": "AlertEvent",
      "type": "object"
    },
    "Attribution": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "principal_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Principal Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "source",
            "officer",
            "dispatch",
            "hospital"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "principal_id",
        "role",
        "at",
        "note"
      ],
      "title": "Attribution",
      "type": "object"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "x1": {
          "maximum": 1,
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "x2": {
          "maximum": 1,
          "minimum": 0,
          "title": "X2",
          "type": "number"
        },
        "y1": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        },
        "y2": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y2",
          "type": "number"
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "title": "BoundingBox",
      "type": "object",
      "x-ordered-pairs": [
        [
          "x1",
          "x2",
          "lt"
        ],
        [
          "y1",
          "y2",
          "lt"
        ]
      ]
    },
    "ContextSummary": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Context Id",
          "type": "string"
        },
        "context_semantics": {
          "const": "unverified_visual_context_no_action_authority",
          "default": "unverified_visual_context_no_action_authority",
          "title": "Context Semantics",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "incident_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Incident Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "model": {
          "$ref": "#/$defs/ModelProvenance"
        },
        "requires_human_review": {
          "const": true,
          "default": true,
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "snapshot_revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Snapshot Revision",
          "type": "integer"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "context_id",
        "incident_id",
        "source_id",
        "snapshot_revision",
        "generated_at",
        "evidence_refs",
        "summary",
        "limitations",
        "model",
        "requires_human_review",
        "context_semantics"
      ],
      "title": "ContextSummary",
      "type": "object"
    },
    "Detection": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "confidence",
        "bbox"
      ],
      "title": "Detection",
      "type": "object"
    },
    "HeartRateValue": {
      "additionalProperties": false,
      "properties": {
        "bpm": {
          "maximum": 400,
          "minimum": 1,
          "title": "Bpm",
          "type": "number"
        },
        "measured_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Until"
        },
        "measurement_origin": {
          "const": "watch_healthkit",
