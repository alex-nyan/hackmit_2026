          },
          "title": "Timings Ms",
          "type": "object"
        },
        "transcript": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranscriptionResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
