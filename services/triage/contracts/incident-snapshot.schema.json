      "required": [
        "media_id",
        "incident_id",
        "source_id",
        "kind",
        "boot_id",
        "sequence",
        "captured_at",
        "processed_at",
        "status",
        "evidence_refs",
        "detections",
        "transcript",
        "models",
        "warnings",
        "timings_ms",
        "requires_human_review",
