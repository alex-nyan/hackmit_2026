{
  "name": "hackmit-2026-paw-patrol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:dispatch": "node scripts/dev.mjs dispatch",
    "dev:officer": "node scripts/dev.mjs officer",
    "dev:hospital": "node scripts/dev.mjs hospital",
    "dev:map": "node scripts/dev.mjs map",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5176",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm run test:launcher && vitest run",
    "test:launcher": "node --test scripts/dev.test.mjs",
    "test:watch": "vitest",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm test",
    "verify": "pnpm run check && pnpm run build"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "lucide-react": "1.31.0",
    "mapbox-gl": "3.31.0",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "26.1.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
