{
  "name": "hackmit-2026-gridlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26.9.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test scripts/check-lockfile.test.mjs && vitest run",
    "test:watch": "vitest",
    "check": "npm run check:lockfile && npm run format:check && npm run typecheck && npm run lint && npm test",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "mapbox-gl": "3.31.0",
    "next": "16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "26.1.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
