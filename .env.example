# Use a Mapbox public browser token (pk.), never a secret token (sk.).
# Create your own at https://account.mapbox.com/access-tokens/.
# If the token has URL restrictions, allow http://localhost:5176/* (Dispatch),
# 5177 (Officer), 5178 (Hospital) and 5173 (the /map route).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Traccar live tracking. Server-side only -- never prefix these with NEXT_PUBLIC_,
# which would ship the credentials to the browser.
TRACCAR_URL=http://localhost:8082
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
# Comma-separated Traccar device ids, or leave blank for every device the
# account can see. Blank is what you want for a shared fleet map.
TRACCAR_DEVICE_IDS=

# Hazard triage service (services/triage). Server-side only -- the bearer token
# must never be prefixed NEXT_PUBLIC_. Leave blank to disable /capture.
TRIAGE_URL=http://127.0.0.1:8090
TRIAGE_API_TOKEN=
# Covers default inference deadlines and overhead; increase for slower providers.
TRIAGE_TIMEOUT_SECONDS=240

# Pin the dashboard to a single role. Leave unset to serve every view plus /map.
# The dev launcher sets this per service; you rarely set it by hand.
# PAW_PATROL_WORKSPACE=dispatch

# Authenticated incident workspace (demo or live).
PAW_PATROL_DATA_MODE=demo
# Live only: generate with `openssl rand -hex 32`. Server-side only.
LIVE_SESSION_SECRET=
# Optional canonical HTTPS origin behind a reverse proxy.
# LIVE_PUBLIC_ORIGIN=https://response.example.org
