# Use a Mapbox public browser token (pk.), never a secret token (sk.).
# Create your own at https://account.mapbox.com/access-tokens/.
# If the token has URL restrictions, allow http://localhost:5176/* (Dispatch),
# 5177 (Officer), 5178 (Hospital) and 5173 (the /map route).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Live tracking has two sources and needs neither one in particular.
#
# 1. Phones. Open /capture, name the unit and press "Share my location": the
#    browser publishes its own fixes to /api/positions, which keeps them in
#    Blob storage. This needs BLOB_READ_WRITE_TOKEN and nothing else, and it is
#    the source that works on a deployment, because the fix travels out from
#    the device rather than needing a server it can reach.
#    `vercel env pull` writes this token into .env.local for you.
BLOB_READ_WRITE_TOKEN=

# 2. Traccar, for a deployment that already has a tracking server. Optional,
#    and merged with whatever the phones are publishing. Server-side only --
#    never prefix these with NEXT_PUBLIC_, which would ship the credentials to
#    the browser. A localhost URL only works for a server on the same machine;
#    a hosted deployment needs a Traccar its own functions can reach.
TRACCAR_URL=http://localhost:8082
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
# Comma-separated Traccar device ids, or leave blank for every device the
# account can see. Blank is what you want for a shared fleet map.
TRACCAR_DEVICE_IDS=

# Hazard triage service (services/triage). Server-side only -- the bearer token
# must never be prefixed NEXT_PUBLIC_. Leave blank to disable /capture.
TRIAGE_URL=http://127.0.0.1:8090
TRIAGE_API_TOKEN=
# The deployment half of cloud consent. Set true only when the triage service
# is configured for a cloud vision model and frames may leave the host; the
# service refuses regardless unless its own TRIAGE_CLOUD_ENABLED agrees.
TRIAGE_ALLOW_CLOUD=false
# Covers default inference deadlines and overhead; increase for slower providers.
TRIAGE_TIMEOUT_SECONDS=240

# Pin the dashboard to a single role. Leave unset to serve every view plus /map.
# The dev launcher sets this per service; you rarely set it by hand.
# PAW_PATROL_WORKSPACE=dispatch

# Authenticated incident workspace (demo or live).
PAW_PATROL_DATA_MODE=demo
# Live only: generate with `openssl rand -hex 32`. Server-side only.
LIVE_SESSION_SECRET=
# Optional canonical HTTPS origin behind a reverse proxy.
# LIVE_PUBLIC_ORIGIN=https://response.example.org

# Direct officer video uses WebRTC. Public STUN is enough on an ordinary LAN;
# a TURN relay is required when officers are on guest Wi-Fi, cellular, or a
# network that isolates clients. Comma-separate multiple URLs. These values
# remain server-side until a signed-in browser requests ICE configuration.
# PAW_PATROL_STUN_URLS=stun:stun.l.google.com:19302
# PAW_PATROL_TURN_URLS=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:5349
# PAW_PATROL_TURN_USERNAME=
# PAW_PATROL_TURN_CREDENTIAL=

# Officer login. Provision one roster entry per officer; never use public credentials.
# Login opens /officer and binds capture to the roster id. Blank keeps guest demo mode.
# PAW_PATROL_OFFICERS='[{"id":"unit-01","name":"Officer One","badge":"01","passcode":"replace-with-private-passcode"}]'
