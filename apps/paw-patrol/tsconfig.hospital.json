{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next-hospital/tsconfig.tsbuildinfo"
  },
  "include": [
    "next-types.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "features/**/*.ts",
    "features/**/*.tsx",
    "next.config.ts",
    "vitest.config.ts",
    ".next-hospital/types/**/*.ts",
    ".next-hospital/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "next-env.d.ts"]
}
