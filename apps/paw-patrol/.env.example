# Use a Mapbox public browser token (pk.), never a secret token (sk.).
# Create your own at https://account.mapbox.com/access-tokens/.
# Allow http://localhost:5176/* and http://127.0.0.1:5176/* for local testing.
# The root launcher also needs those hosts on ports 5177 (Officer) and 5178 (Hospital).
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Explicit data mode: demo uses synthetic signals; live requires operator sign-in.
PAW_PATROL_DATA_MODE=demo
# Loopback HTTP is for development only. Off-host connections require HTTPS.
TRIAGE_URL=http://127.0.0.1:8090
# Live only: generate with `openssl rand -hex 32`. Keep this server-side and private.
LIVE_SESSION_SECRET=
# HTTPS deployment behind a reverse proxy: exact browser origin, without a trailing slash.
# LIVE_PUBLIC_ORIGIN=https://response.example.org
